{% extends "base_logged_in.twig" %}

{% block content %}
    <div class="panel-heading">
        <h1>{% trans %}Garmin Connect sync{% endtrans %}</h1>
    </div>

    <div class="panel-content">
        <p class="info">
            {% trans %}This uses your normal Garmin Connect login to fetch new activities on demand. This is not an official Garmin feature - it can stop working if Garmin changes their login system.{% endtrans %}
        </p>

        {% include 'flashmessages.html.twig' %}

        {% if error %}
            <p class="error">{{ error }}</p>
        {% endif %}

        {% if connected %}
            <p class="text">
                {% if lastSync > 0 %}
                    {% trans with {'%date%': lastSync|date('d.m.Y H:i')} %}Last sync: %date%{% endtrans %}
                {% else %}
                    {% trans %}Not synced yet.{% endtrans %}
                {% endif %}
            </p>

            <div id="garmin-sync-messages"></div>

            <p class="c">
                <input type="button" id="garmin-sync-run" class="submit" value="{% trans %}Sync now{% endtrans %}">
            </p>

            <script>
                (function($){
                    var $button = $('#garmin-sync-run');
                    var $messages = $('#garmin-sync-messages');
                    var runningLabel = '{{ 'Syncing...'|trans|e('js') }}';
                    var defaultLabel = $button.val();

                    $button.click(function(){
                        $button.prop('disabled', true).val(runningLabel);
                        $messages.empty();

                        $.ajax({
                            url: '{{ url('tools-garmin-sync-run') }}',
                            method: 'POST',
                            dataType: 'json'
                        }).done(function(data){
                            if (data.error) {
                                $messages.append('<p class="error">'+data.error+'</p>');
                                $button.prop('disabled', false).val(defaultLabel);
                            } else if (data.files && data.files.length) {
                                // Same hand-off the regular multi-file upload
                                // uses: load the file-picker/preview page into
                                // the already-open overlay via AJAX, instead
                                // of navigating there directly (that page's
                                // own script assumes it is loaded this way).
                                $("#ajax").loadDiv('{{ url('activity-upload') }}?files='+encodeURIComponent(data.files.join(';')));
                            } else {
                                if (data.message) {
                                    $messages.append('<p class="text">'+data.message+'</p>');
                                }
                                $button.prop('disabled', false).val(defaultLabel);
                            }

                            if (data.info) {
                                $messages.append('<p class="info">'+data.info+'</p>');
                            }
                        }).fail(function(){
                            $messages.append('<p class="error">{{ 'The request failed.'|trans|e('js') }}</p>');
                            $button.prop('disabled', false).val(defaultLabel);
                        });
                    });
                })(jQuery);
            </script>

            <div class="panel-heading panel-sub-heading">
                <h1>{% trans %}Skip older activities{% endtrans %}</h1>
            </div>
            <p class="info">
                {% trans %}By default sync starts from your very first Garmin Connect activity, which can be a lot of activities if you have a long history. Set a date here to only fetch activities from that date onwards instead.{% endtrans %}
            </p>
            <form method="post" action="{{ url('tools-garmin-sync-set-since') }}" class="ajax no-automatic-reload" id="garmin-sync-since">
                <div class="padding-5">
                    <label for="since_date">{% trans %}Only sync activities from{% endtrans %}</label>
                    <input type="date" id="since_date" name="since_date" value="{{ lastSync > 0 ? (lastSync|date('Y-m-d')) : '' }}" required>
                </div>
                <div class="c">
                    <input type="submit" class="submit" value="{% trans %}Set start date{% endtrans %}">
                </div>
            </form>

            <p class="c">
                <a class="window" href="{{ url('tools-garmin-sync-disconnect') }}">{% trans %}Disconnect Garmin Connect account{% endtrans %}</a>
            </p>
        {% else %}
            <form method="post" action="{{ url('tools-garmin-sync') }}" class="ajax no-automatic-reload" id="garmin-sync-login">
                <div class="padding-5">
                    <label for="garmin_email">{% trans %}Garmin Connect email{% endtrans %}</label>
                    <input type="email" id="garmin_email" name="garmin_email" class="fullwidth" required>
                </div>
                <div class="padding-5">
                    <label for="garmin_password">{% trans %}Garmin Connect password{% endtrans %}</label>
                    <input type="password" id="garmin_password" name="garmin_password" class="fullwidth" required>
                </div>
                <p class="info">
                    {% trans %}Your password is only used once to establish a session and is not stored.{% endtrans %}
                </p>
                <div class="c">
                    <input type="submit" class="submit" value="{% trans %}Connect{% endtrans %}">
                </div>
            </form>
        {% endif %}
    </div>
{% endblock %}
