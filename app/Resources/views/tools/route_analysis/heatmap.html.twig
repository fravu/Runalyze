{% extends "base_logged_in.twig" %}

{% block content %}
    {% include 'tools/route_analysis/_shared.html.twig' %}

    <style>
        .ra-heat-wrap { display:flex; gap:10px; align-items:stretch; }
        .ra-heat-wrap .ra-map { flex:1; min-width:0; margin:0; }
        #ra-heat-side { width:340px; height:480px; overflow:auto; border:1px solid #ccc; background:#fff; }
        #ra-heat-side .head { padding:6px 8px; border-bottom:1px solid #ccc; background:#f4f4f4; position:sticky; top:0; }
        #ra-heat-side .head .ra-chips { margin:4px 0 0; }
        #ra-heat-side .row { display:flex; gap:6px; align-items:center; padding:5px 8px; border-bottom:1px solid #eee; cursor:pointer; }
        #ra-heat-side .row:hover { background:#f0f4ff; }
        #ra-heat-side .row.selected { background:#fff4c2; }
        #ra-heat-side .row .txt { flex:1; min-width:0; }
        #ra-heat-side .row .txt small { color:#666; display:block; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
        #ra-heat-side .row .open { padding:2px 6px; border:1px solid #999; border-radius:3px; background:#fff; }
        #ra-heat-side .empty { padding:10px; color:#666; }
        @media (max-width: 900px) { .ra-heat-wrap { flex-direction:column; } #ra-heat-side { width:auto; height:auto; max-height:360px; } }
    </style>

    <div class="panel-menu">
        <ul>
            <li><a class="ajax" target="ajax" href="{{ url('tools-climbs') }}">Anstiege</a></li>
            <li><a class="ajax" target="ajax" href="{{ url('tools-segments') }}">Segmente</a></li>
            <li><a class="ajax" target="ajax" href="{{ url('tools-route-colors') }}"><i class="fa fa-paint-brush"></i> Farben</a></li>
        </ul>
    </div>

    <div class="panel-heading">
        <h1>Heatmap</h1>
    </div>

    <div class="panel-content">
        <div id="ra-heat-status" class="ra-progress"><i class="fa fa-spinner fa-spin"></i> Routen werden geladen … Beim ersten Aufruf kann das bei vielen Aktivitäten etwas dauern.</div>

        <div id="ra-heat-controls" style="display:none">
            <div class="ra-chips" id="ra-heat-sports"></div>
            <div class="ra-chips">
                <label>Von <select id="ra-heat-from"></select></label>
                <label>bis <select id="ra-heat-to"></select></label>
                <label>Deckkraft <input type="range" id="ra-heat-alpha" min="5" max="80" value="35" style="vertical-align:middle"></label>
                <span id="ra-heat-info" style="color:#555"></span>
            </div>
        </div>

        <div class="ra-heat-wrap">
            <div id="ra-heat-map" class="ra-map"></div>
            <div id="ra-heat-side"><div class="empty">Auf eine Strecke in der Karte klicken: Hier erscheinen dann alle Aktivitäten, die dort vorbeikamen.</div></div>
        </div>
    </div>

    <script>
    (function($){
        var data = null, sportColor = {}, sportOn = {}, sportName = {}, map = null, layer = null;
        var hits = [], selected = {}, onlyHits = false, clickMarker = null, highlight = null, hoverLine = null;

        var HeatLayer = L.Class.extend({
            initialize: function(draw) { this._draw = draw; },
            onAdd: function(m) {
                this._map = m;
                this._canvas = L.DomUtil.create('canvas', 'ra-heat-canvas leaflet-zoom-hide');
                m.getPanes().overlayPane.appendChild(this._canvas);
                m.on('moveend resize', this._reset, this);
                this._reset();
            },
            onRemove: function(m) {
                m.getPanes().overlayPane.removeChild(this._canvas);
                m.off('moveend resize', this._reset, this);
            },
            redraw: function() { if (this._map) this._reset(); },
            _reset: function() {
                var size = this._map.getSize();
                L.DomUtil.setPosition(this._canvas, this._map.containerPointToLayerPoint([0, 0]));
                this._canvas.width = size.x;
                this._canvas.height = size.y;
                this._canvas.style.width = size.x + 'px';
                this._canvas.style.height = size.y + 'px';
                this._draw(this._canvas, this._map);
            }
        });

        function esc(text) { return $('<div>').text(text || '').html(); }

        function decodeActivities() {
            var len = data.precision;
            data.activities.forEach(function(a) {
                var p = a.p, lat = [], lng = [], i = 0;
                var minLat = 90, maxLat = -90, minLng = 180, maxLng = -180;
                while (i < p.length) {
                    if (p.charAt(i) === '-') { lat.push(NaN); lng.push(NaN); i++; continue; }
                    var c = RouteTools.decodeGeohash(p, i, len);
                    lat.push(c[0]); lng.push(c[1]);
                    if (c[0] < minLat) minLat = c[0]; if (c[0] > maxLat) maxLat = c[0];
                    if (c[1] < minLng) minLng = c[1]; if (c[1] > maxLng) maxLng = c[1];
                    i += len;
                }
                a.lat = lat; a.lng = lng; a.box = [minLat, minLng, maxLat, maxLng]; a.proj = {};
                a.year = new Date(a.t * 1000).getFullYear();
                delete a.p;
            });
        }

        function visible() {
            var from = +$('#ra-heat-from').val(), to = +$('#ra-heat-to').val();
            var ids = {};
            if (onlyHits) hits.forEach(function(a) { ids[a.id] = true; });
            return data.activities.filter(function(a) {
                return onlyHits ? ids[a.id] : (sportOn[a.s] && a.year >= from && a.year <= to);
            });
        }

        function projected(a, zoom) {
            if (!a.proj[zoom]) {
                var n = a.lat.length, xy = new Float64Array(n * 2);
                for (var i = 0; i < n; i++) {
                    if (isNaN(a.lat[i])) { xy[2 * i] = NaN; xy[2 * i + 1] = NaN; continue; }
                    var pt = map.project([a.lat[i], a.lng[i]], zoom);
                    xy[2 * i] = pt.x; xy[2 * i + 1] = pt.y;
                }
                a.proj[zoom] = xy;
            }
            return a.proj[zoom];
        }

        function offset() {
            var origin = map.getPixelOrigin(), zero = map.layerPointToContainerPoint([0, 0]);
            return [zero.x - origin.x, zero.y - origin.y];
        }

        function draw(canvas, m) {
            var ctx = canvas.getContext('2d'), zoom = m.getZoom(), off = offset();
            var bounds = m.getBounds(), acts = visible(), km = 0;
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            ctx.globalAlpha = $('#ra-heat-alpha').val() / 100;
            ctx.lineWidth = zoom >= 15 ? 3 : 2;
            ctx.lineCap = 'round'; ctx.lineJoin = 'round';
            acts.forEach(function(a) {
                km += a.d;
                var b = a.box;
                if (b[2] < bounds.getSouth() || b[0] > bounds.getNorth() || b[3] < bounds.getWest() || b[1] > bounds.getEast()) return;
                var xy = projected(a, zoom), pen = false;
                ctx.strokeStyle = sportColor[a.s];
                ctx.beginPath();
                for (var i = 0; i < xy.length; i += 2) {
                    if (isNaN(xy[i])) { pen = false; continue; }
                    var x = xy[i] + off[0], y = xy[i + 1] + off[1];
                    if (pen) ctx.lineTo(x, y); else { ctx.moveTo(x, y); pen = true; }
                }
                ctx.stroke();
            });
            $('#ra-heat-info').text(acts.length + ' Aktivitäten · ' + Math.round(km).toLocaleString('de-DE') + ' km' + (onlyHits ? ' (nur Treffer)' : ''));
        }

        function lines(a) {
            var parts = [], cur = [];
            for (var i = 0; i < a.lat.length; i++) {
                if (isNaN(a.lat[i])) { if (cur.length > 1) parts.push(cur); cur = []; continue; }
                cur.push([a.lat[i], a.lng[i]]);
            }
            if (cur.length > 1) parts.push(cur);
            return parts;
        }

        function drawHighlight() {
            if (highlight) map.removeLayer(highlight);
            highlight = L.featureGroup();
            hits.forEach(function(a) {
                if (!selected[a.id]) return;
                lines(a).forEach(function(part) {
                    L.polyline(part, { color: '#000', weight: 8, opacity: 1 }).addTo(highlight);
                    L.polyline(part, { color: RouteTools.color.selection, weight: 5, opacity: 1 }).addTo(highlight);
                });
            });
            highlight.addTo(map);
            if (clickMarker) clickMarker.bringToFront();
        }

        function hover(a) {
            if (hoverLine) { map.removeLayer(hoverLine); hoverLine = null; }
            if (!a) return;
            hoverLine = L.featureGroup();
            lines(a).forEach(function(part) { L.polyline(part, { color: RouteTools.color.line, weight: 4, opacity: 1, dashArray: '6,4' }).addTo(hoverLine); });
            hoverLine.addTo(map);
        }

        function renderSide() {
            var $side = $('#ra-heat-side').empty();
            if (!hits.length) {
                $side.html('<div class="empty">Keine Aktivität an dieser Stelle. Näher heranzoomen oder genauer auf eine Linie klicken.</div>');
                return;
            }
            var nSel = hits.filter(function(a) { return selected[a.id]; }).length;
            var $head = $('<div class="head"></div>').appendTo($side);
            $head.append('<strong>' + hits.length + ' Aktivitäten an dieser Stelle</strong>' + (nSel ? ' · ' + nSel + ' ausgewählt' : ''));
            var $btns = $('<div class="ra-chips"></div>').appendTo($head);
            $('<span class="ra-chip"></span>').text(onlyHits ? 'Wieder alle zeigen' : 'Nur diese in der Karte').on('click', function() {
                onlyHits = !onlyHits; layer.redraw(); renderSide();
            }).appendTo($btns);
            $('<span class="ra-chip">Alle auswählen</span>').on('click', function() {
                hits.forEach(function(a) { selected[a.id] = true; }); drawHighlight(); renderSide();
            }).appendTo($btns);
            if (nSel) {
                $('<span class="ra-chip">Auswahl aufheben</span>').on('click', function() { selected = {}; drawHighlight(); renderSide(); }).appendTo($btns);
                $('<span class="ra-chip">Auf Auswahl zoomen</span>').on('click', function() { if (highlight && highlight.getLayers().length) map.fitBounds(highlight.getBounds(), { padding: [20, 20] }); }).appendTo($btns);
            }
            hits.forEach(function(a) {
                var d = new Date(a.t * 1000);
                var $row = $('<div class="row"></div>').toggleClass('selected', !!selected[a.id]).appendTo($side);
                $('<input type="checkbox">').prop('checked', !!selected[a.id]).appendTo($row);
                $('<i class="dot" style="display:inline-block;width:10px;height:10px;border-radius:50%;border:1px solid #000"></i>').css('background', sportColor[a.s]).appendTo($row);
                $('<div class="txt"></div>').html(
                    '<strong>' + d.toLocaleDateString('de-DE') + '</strong> · ' + esc(sportName[a.s]) + ' · ' + a.d.toFixed(1).replace('.', ',') + ' km' +
                    '<small>' + (esc(a.n) || '&nbsp;') + '</small>'
                ).appendTo($row);
                $('<span class="open" title="Aktivität öffnen"><i class="fa fa-external-link"></i></span>').on('click', function(e) {
                    e.stopPropagation(); RouteTools.openActivity(a.id);
                }).appendTo($row);
                $row.on('click', function() {
                    if (selected[a.id]) delete selected[a.id]; else selected[a.id] = true;
                    drawHighlight(); renderSide();
                }).on('mouseenter', function() { hover(a); }).on('mouseleave', function() { hover(null); });
            });
        }

        function findHits(e) {
            var zoom = map.getZoom(), off = offset(), cp = map.latLngToContainerPoint(e.latlng), found = [];
            var tol = 8, ll = e.latlng, dLat = 0.02, dLng = 0.03;
            var from = +$('#ra-heat-from').val(), to = +$('#ra-heat-to').val();
            data.activities.forEach(function(a) {
                if (!sportOn[a.s] || a.year < from || a.year > to) return;
                var b = a.box;
                if (ll.lat < b[0] - dLat || ll.lat > b[2] + dLat || ll.lng < b[1] - dLng || ll.lng > b[3] + dLng) return;
                var xy = projected(a, zoom);
                for (var i = 0; i < xy.length; i += 2) {
                    var dx = xy[i] + off[0] - cp.x, dy = xy[i + 1] + off[1] - cp.y;
                    if (dx * dx + dy * dy <= tol * tol) { found.push(a); break; }
                }
            });
            found.sort(function(a, b) { return b.t - a.t; });
            hits = found; selected = {};
            if (onlyHits) { onlyHits = false; layer.redraw(); }
            if (clickMarker) map.removeLayer(clickMarker);
            clickMarker = L.circleMarker(e.latlng, { radius: 8, color: '#000', weight: 2, fillColor: RouteTools.color.selection, fillOpacity: 1 }).addTo(map);
            drawHighlight();
            renderSide();
        }

        function initialBounds() {
            var acts = visible();
            if (!acts.length) return null;
            var lats = acts.map(function(a) { return a.box[0]; }).sort(function(a, b) { return a - b; });
            var lngs = acts.map(function(a) { return a.box[1]; }).sort(function(a, b) { return a - b; });
            var mLat = lats[Math.floor(lats.length / 2)], mLng = lngs[Math.floor(lngs.length / 2)], bounds = null;
            acts.forEach(function(a) {
                if (Math.abs(a.box[0] - mLat) > 0.5 || Math.abs(a.box[1] - mLng) > 0.7) return;
                var bb = L.latLngBounds([a.box[0], a.box[1]], [a.box[2], a.box[3]]);
                bounds = bounds ? bounds.extend(bb) : bb;
            });
            return bounds;
        }

        function buildControls() {
            var $sports = $('#ra-heat-sports');
            data.sports.forEach(function(s, i) {
                sportColor[s.id] = RouteTools.sportColor(s.id, i);
                sportName[s.id] = s.name;
                sportOn[s.id] = i < 3;
                $('<span class="ra-chip"></span>').toggleClass('off', !sportOn[s.id])
                    .html('<i class="dot" style="background:' + sportColor[s.id] + ';border:1px solid #000"></i>' + esc(s.name) + ' <small>(' + s.count + ')</small>')
                    .on('click', function() { sportOn[s.id] = !sportOn[s.id]; $(this).toggleClass('off', !sportOn[s.id]); layer.redraw(); })
                    .appendTo($sports);
            });
            var years = data.activities.map(function(a) { return a.year; });
            var y0 = Math.min.apply(null, years), y1 = Math.max.apply(null, years);
            for (var y = y0; y <= y1; y++) {
                $('#ra-heat-from').append('<option' + (y === y0 ? ' selected' : '') + '>' + y + '</option>');
                $('#ra-heat-to').append('<option' + (y === y1 ? ' selected' : '') + '>' + y + '</option>');
            }
            $('#ra-heat-from, #ra-heat-to').on('change', function() { layer.redraw(); });
            $('#ra-heat-alpha').on('input change', function() { layer.redraw(); });
            $('#ra-heat-controls').show();
        }

        Runalyze.Overlay.setBigSize();
        map = RouteTools.createMap('ra-heat-map', '{{ layer|e('js') }}');
        map.setView([51, 10], 6);

        $.getJSON('{{ url('tools-heatmap-data') }}').done(function(json) {
            data = json;
            if (!data.activities.length) {
                $('#ra-heat-status').html('<p class="info">Es gibt noch keine Aktivitäten mit GPS-Daten.</p>');
                return;
            }
            decodeActivities();
            buildControls();
            $('#ra-heat-status').hide();
            var b = initialBounds();
            if (b) map.fitBounds(b);
            layer = new HeatLayer(draw);
            map.addLayer(layer);
            map.on('click', findHits);
        }).fail(function(xhr) {
            $('#ra-heat-status').html('<p class="error">Die Routen konnten nicht geladen werden (' + xhr.status + ' ' + xhr.statusText + ').</p>');
        });
    })(jQuery);
    </script>
{% endblock %}
